{
	"name": "inbox-intelligence",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"check-types": "turbo run check-types",
		"lint": "biome check apps packages",
		"lint:fix": "biome check apps packages --write",
		"format": "biome format .",
		"format:write": "biome format . --write",
		"db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
		"db:down": "docker compose -f infra/docker-compose.yml down",
		"db:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=200",
		"db:reset": "docker compose -f infra/docker-compose.yml down -v",
		"setup": "pnpm i && pnpm db:up",
		"dev:web": "turbo run dev --filter=@inbox/web",
		"dev:api": "turbo run dev --filter=@inbox/api",
		"dev:worker": "turbo run dev --filter=@inbox/worker",
		"prepare": "husky",
		"commit": "cz",
		"db:generate": "pnpm -F @inbox/db prisma:generate",
		"db:migrate:dev": "pnpm -F @inbox/db prisma:migrate:dev",
		"db:migrate:deploy": "pnpm -F @inbox/db prisma:migrate:deploy",
		"db:studio": "pnpm -F @inbox/db prisma:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@commitlint/cli": "^20.4.2",
		"@commitlint/config-conventional": "^20.4.2",
		"@types/node": "^25.3.3",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.1",
		"turbo": "^2.8.11",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": [
			"node ./node_modules/@biomejs/biome/bin/biome check --write --no-errors-on-unmatched"
		]
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"dotenv": "^17.3.1",
		"pg": "^8.19.0"
	}
}

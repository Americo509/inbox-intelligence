# ================
# Base (monorepo)
# ================
NODE_ENV=development

# Portas (ajuste se quiser)
WEB_PORT=3000
API_PORT=3333

# ================
# Postgres (docker)
# ================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=inbox
POSTGRES_PASSWORD=inbox
POSTGRES_DB=inbox

# URL canônica (use essa no app)
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox?schema=public

# ================
# Redis (docker)
# ================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ================
# API (backend)
# ================
API_BASE_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000

# Segredos (dev)
JWT_SECRET=dev-change-me
ENCRYPTION_KEY=dev-32-bytes-minimum-change-me!!!

# ================
# Worker/Queues (BullMQ etc.)
# ================
QUEUE_PREFIX=inbox
QUEUE_CONCURRENCY=5

# ================
# Web (Next.js)
# ================
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================
# Observabilidade (opcional)
# ================
LOG_LEVEL=debug